// Prisma Schema: Promotions, Products & Categories (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionStatus {
  PROGRAMMED
  ACTIVE
  FINISHED
}

model Category {
  id                String      @id @default(uuid())
  name              String      @unique @db.VarChar(100)
  description       String?     @db.Text
  position          Int         @default(0)
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  products          Product[]
  promotions        Promotion[] @relation("PromotionCategories")
  primaryPromotions Promotion[] @relation("PromotionPrimaryCategory")

  @@map("categories")
}

model Product {
  id                String      @id @default(uuid())
  name              String      @db.VarChar(150)
  description       String?     @db.Text
  price             Decimal     @db.Decimal(10, 2)
  sku               String?     @unique @db.VarChar(50)
  imageUrl          String?     @map("image_url") @db.Text
  isActive          Boolean     @default(true) @map("is_active")
  categoryId        String?     @map("category_id")
  category          Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  promotions        Promotion[] @relation("PromotionProducts")
  primaryPromotions Promotion[] @relation("PromotionPrimaryProduct")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Promotion {
  id            String          @id @default(uuid())
  name          String          @db.VarChar(150)
  scopeType     String          @default("CATEGORY") @map("scope_type")
  categoryId    String?         @map("category_id")
  category      Category?       @relation("PromotionPrimaryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  productId     String?         @map("product_id")
  product       Product?        @relation("PromotionPrimaryProduct", fields: [productId], references: [id], onDelete: SetNull)
  categories    Category[]      @relation("PromotionCategories")
  products      Product[]       @relation("PromotionProducts")
  discountType  DiscountType    @map("discount_type")
  discountValue Decimal         @map("discount_value") @db.Decimal(10, 2)
  startDate     DateTime        @map("start_date")
  endDate       DateTime        @map("end_date")
  status        PromotionStatus @default(PROGRAMMED)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([startDate, endDate])
  @@index([categoryId])
  @@index([productId])
  @@index([scopeType])
  @@map("promotions")
}
